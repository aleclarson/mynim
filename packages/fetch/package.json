{
  "name": "@mygo-plugins/fetch",
  "version": "0.5.5",
  "description": "A Fetch API bridge that makes HTTP requests from Mynim apps",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src/index.ts",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target browser --external mygo-runtime",
    "test": "bun test",
    "prepublishOnly": "bun run build && bun test"
  },
  "peerDependencies": {
    "mygo-runtime": "^0.5.5"
  }
}
